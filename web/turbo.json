{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["gen", "^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "gen": {},
    "lint": {},
    "test": {
      "dependsOn": ["lint", "^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
